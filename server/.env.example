# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopverse_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="shopverse_jwt_access_super_secret_key_2026_secure"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="shopverse_jwt_refresh_super_secret_key_2026_secure"
JWT_REFRESH_EXPIRES_IN="7d"

# VNPAY Sandbox Configuration
VNP_TMN_CODE="YOUR_TMN_CODE"
VNP_HASH_SECRET="YOUR_HASH_SECRET"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:5173/payment/vnpay-return"
