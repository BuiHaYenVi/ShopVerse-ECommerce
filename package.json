{
  "name": "shopverse-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "ShopVerse - Enterprise Full-Stack E-Commerce Platform built with NestJS, React, PostgreSQL & VNPAY",
  "scripts": {
    "server:dev": "npm --prefix server run start:dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
