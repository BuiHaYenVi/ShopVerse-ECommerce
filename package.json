    "client:test": "npm --prefix client run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up --build"
  },
  "keywords": [
    "ecommerce",
    "nestjs",
    "react",
    "typescript",
    "postgresql",
    "prisma",
